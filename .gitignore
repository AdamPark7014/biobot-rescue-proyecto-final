# Archivos que se regeneran al compilar; no se versionan.

# Notas internas del equipo (rúbrica, pendientes): no van al repositorio público
notas-internas/

# Quartus: bases de datos intermedias e imagen de flash (los .sof sí se guardan)
db/
incremental_db/
greybox_tmp/
*.qws
*.pof
*.jdi
compile.log

# Active-HDL: espacio de trabajo generado por activehdl/crear_workspace.do
activehdl/BioBot_Rescue/

# LaTeX: auxiliares (los PDF finales están en la raíz)
latex/*.aux
latex/*.log
latex/*.toc
latex/*.out
latex/*.synctex.gz
latex/main.pdf
latex/hoja.pdf

# Simulación: ejecutables y bitácoras de Icarus
sim/*.out
sim/*.vcd
sim/*.log

# Python
__pycache__/

# Quartus: temporales
*.jditmp

# Prueba de la terminal: archivos intermedios
sim/fuentes_sonda.txt
sim/sondas.txt
